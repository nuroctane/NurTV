+        // Seed only profiles created from scratch; existing profiles and removals are untouched.
+        // These snapshots contain public manifests, not accounts or credentials.
+        val seededAddons = mutableListOf(addonEntity)
+        val seededConfigs = configs.toMutableList()
+        val entries = context.assets.open("household-addons.json").bufferedReader().use {
+            JsonParser.parseReader(it).asJsonArray
+        }
+        entries.forEach { entry ->
+            val item = entry.asJsonObject
+            val url = item.get("url").asString.removeSuffix("/manifest.json")
+            val seed = gson.fromJson(item.get("manifest"), Manifest::class.java)
+            fun supports(name: String) = seed.resources.orEmpty().any { resource ->
+                (resource.isJsonPrimitive && resource.asString == name) ||
+                    (resource.isJsonObject && resource.asJsonObject.get("name")?.asString == name)
+            }
+            seededAddons.add(AddonEntity(
+                transportUrl = url, id = seed.id, name = seed.name, version = seed.version,
+                description = seed.description, iconUrl = seed.logo, isTrusted = false,
+                isEnabled = true, catalogsJson = gson.toJson(seed.catalogs.orEmpty()),
+                supportsMeta = supports("meta"), supportsStream = supports("stream"),
+                typesJson = gson.toJson(seed.types.orEmpty()),
+                idPrefixesJson = gson.toJson(seed.idPrefixes.orEmpty())
+            ))
+            seed.catalogs.orEmpty().forEach { catalog ->
+                seededConfigs.add(CatalogConfigEntity(
+                    uniqueId = "$url/${catalog.type}/${catalog.id}", transportUrl = url,
+                    addonName = seed.name, catalogType = catalog.type, catalogId = catalog.id,
+                    catalogName = catalog.name, customTitle = null, showInHome = true,
+                    showInMovies = catalog.type == "movie", showInSeries = catalog.type == "series",
+                    homeOrder = 999, moviesOrder = 999, seriesOrder = 999
+                ))
+            }
+        }
         return ProfileRuntimeSnapshot(
-            addons = listOf(addonEntity),
-            catalogConfigs = configs,
+            addons = seededAddons,
+            catalogConfigs = seededConfigs,
             hubRows = emptyList(),
             hubRowItems = emptyList(),
             watchHistory = emptyList()
