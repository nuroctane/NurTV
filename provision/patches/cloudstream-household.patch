diff --git a/app/src/main/java/com/lagradost/cloudstream3/plugins/HouseholdSetup.kt b/app/src/main/java/com/lagradost/cloudstream3/plugins/HouseholdSetup.kt
new file mode 100644
index 0000000..0b19ba2
--- /dev/null
+++ b/app/src/main/java/com/lagradost/cloudstream3/plugins/HouseholdSetup.kt
@@ -0,0 +1,59 @@
+package com.lagradost.cloudstream3.plugins
+
+import android.app.Activity
+import androidx.preference.PreferenceManager
+import com.lagradost.cloudstream3.AutoDownloadMode
+import com.lagradost.cloudstream3.CloudStreamApp.Companion.getKey
+import com.lagradost.cloudstream3.CloudStreamApp.Companion.setKey
+import com.lagradost.cloudstream3.R
+import com.lagradost.cloudstream3.mvvm.logError
+import com.lagradost.cloudstream3.ui.settings.extensions.RepositoryData
+import org.json.JSONObject
+
+/**
+ * Household build: adds the repositories in assets/household-repos.json once,
+ * then downloads their plugins for the listed languages once. Later removals
+ * are kept because nothing here runs again after the first seed.
+ */
+object HouseholdSetup {
+    private const val SEEDED_KEY = "HOUSEHOLD_REPOS_SEEDED"
+    private const val ASSET = "household-repos.json"
+
+    /** Returns true when this call seeded the repositories. */
+    suspend fun seedOnce(activity: Activity): Boolean {
+        if (getKey(SEEDED_KEY, false) == true) return false
+        try {
+            val json = JSONObject(activity.assets.open(ASSET).bufferedReader().use { it.readText() })
+
+            val repos = json.getJSONArray("repositories")
+            for (i in 0 until repos.length()) {
+                val repo = repos.getJSONObject(i)
+                RepositoryManager.addRepository(
+                    RepositoryData(repo.getString("name"), repo.getString("url"))
+                )
+            }
+
+            val languages = json.optJSONArray("languages")
+            if (languages != null && languages.length() > 0) {
+                val prefs = PreferenceManager.getDefaultSharedPreferences(activity)
+                val langKey = activity.getString(R.string.provider_lang_key)
+                if (!prefs.contains(langKey)) {
+                    val set = (0 until languages.length()).map { languages.getString(it) }.toSet()
+                    prefs.edit().putStringSet(langKey, set).apply()
+                }
+            }
+        } catch (t: Throwable) {
+            logError(t)
+            return false
+        }
+        setKey(SEEDED_KEY, true)
+        return true
+    }
+
+    suspend fun downloadSeededPlugins(activity: Activity) {
+        PluginManager.___DO_NOT_CALL_FROM_A_PLUGIN_downloadNotExistingPluginsAndLoad(
+            activity,
+            AutoDownloadMode.FilterByLang
+        )
+    }
+}
